{
  "name": "quasar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:ws": "tsx server-ws.ts",
    "db:init": "node -e \"if (!require('fs').existsSync('.env')) require('fs').writeFileSync('.env', 'DATABASE_URL=\\\"file:./quasar.db\\\"\\n')\" && prisma generate && prisma db push",
    "dev": "concurrently -k -n \"NEXT,WS\" -c \"cyan.bold,magenta.bold\" \"npm:dev:next\" \"npm:dev:ws\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.34.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.19.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
